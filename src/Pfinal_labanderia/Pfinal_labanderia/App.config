<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!--
		La cadena de conexión "ConexionSQLServer" NO se escribe aquí porque este archivo se sube a GitHub.
		Se lee de Conexion.config (misma carpeta), que queda solo en cada computadora (está en .gitignore).
		Si falta, crearlo copiando Conexion.config.ejemplo y escribiendo la contraseña real.
	-->
	<connectionStrings configSource="Conexion.config" />
</configuration>
